# Local GS repo copy -- never commit (and never let sync-docs git add -A sweep it into docs-only)
ml-vol-estimator/

# Trailhead (GS hackathon).
# restored/ and openclaw/ stay out: ~1064 files of borrowed source used only as
# generation targets; committing them would put 455 .py files on a branch that
# must have none.
hackathon/openclaw/
# restored/ IS committed on main (it is the proving-ground repo). These stay out:
hackathon/restored/**/.env
hackathon/restored/**/.venv/
hackathon/restored/**/__pycache__/
# out/ IS committed -- the generated bundles are the deliverable, and the
# narration cache under out/.trailhead/ is what makes a rehearsal replay
# byte-identically to the run on stage.
.trailhead/
!hackathon/out/
!hackathon/out/**
# __pycache__/ and *.pyc are already covered by the Python block above.

# Screen recordings — a 133 MiB blob once blocked a push (GitHub caps files at 100 MiB)
*.mkv
*.mp4
