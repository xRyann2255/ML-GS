\@writefile{lof}{\contentsline {figure}{\numberline {8.3}{\ignorespaces Implied volatility vs.\ moneyness at a fixed maturity. The \textcolor {warnred}{red solid line} shows the typical equity skew: IV increases sharply for low strikes (OTM puts) due to crash-risk demand. The \textcolor {defblue}{blue dashed line} shows a symmetric ``smile'' common in FX markets, where both tails carry extra uncertainty. The \textcolor {gray}{gray dotted line} is the flat surface that Black-Scholes would predict.}}{115}{figure.8.3}\protected@file@percent }
\newlabel{fig:iv-smile-skew}{{8.3}{115}{Implied volatility vs.\ moneyness at a fixed maturity. The \textcolor {warnred}{red solid line} shows the typical equity skew: IV increases sharply for low strikes (OTM puts) due to crash-risk demand. The \textcolor {defblue}{blue dashed line} shows a symmetric ``smile'' common in FX markets, where both tails carry extra uncertainty. The \textcolor {gray}{gray dotted line} is the flat surface that Black-Scholes would predict}{figure.8.3}{}}
