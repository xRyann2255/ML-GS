\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.2}Diagram: How RV and BPV Respond to a Jump}{54}{subsection.4.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces How a jump affects $\operatorname  {RV}$ vs.\ $\operatorname  {BPV}$. \textbf  {Left:} the jump return $r_4$ contributes $3.24 \times 10^{-4}$ to $\operatorname  {RV}$ (via $r_4^2$), dominating all other terms. \textbf  {Right:} in $\operatorname  {BPV}$, the jump is multiplied by its normal-sized neighbors. The two terms involving $r_4$ contribute only $0.17$ and $0.11 \times 10^{-4}$, roughly 50$\times $ smaller than the squared jump. $\operatorname  {BPV}$ ``sees through'' the jump and recovers the continuous variation.}}{54}{figure.4.2}\protected@file@percent }
\newlabel{fig:rv-vs-bpv}{{4.2}{54}{How a jump affects $\RV $ vs.\ $\BPV $. \textbf {Left:} the jump return $r_4$ contributes $3.24 \times 10^{-4}$ to $\RV $ (via $r_4^2$), dominating all other terms. \textbf {Right:} in $\BPV $, the jump is multiplied by its normal-sized neighbors. The two terms involving $r_4$ contribute only $0.17$ and $0.11 \times 10^{-4}$, roughly 50$\times $ smaller than the squared jump. $\BPV $ ``sees through'' the jump and recovers the continuous variation}{figure.4.2}{}}
\newlabel{fig:rv-vs-bpv@cref}{{[figure][2][4]4.2}{[1][54][]54}{}{}{}}
\citation{BNS2006}
