\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Sample paths of fractional Brownian motion at four values of the Hurst exponent $H$. Top left ($H = 0.1$, red): extremely rough, rapidly oscillating. Top right ($H = 0.3$, orange): rough but with visible short-range structure. Bottom left ($H = 0.5$, blue): standard Brownian motion, the familiar random walk. Bottom right ($H = 0.7$, green): smooth, trending trajectory. Empirically, $\log \operatorname  {RV}$ behaves like the top-left panel.}}{97}{figure.7.1}\protected@file@percent }
\newlabel{fig:hurst-paths}{{7.1}{97}{Sample paths of fractional Brownian motion at four values of the Hurst exponent $H$. Top left ($H = 0.1$, red): extremely rough, rapidly oscillating. Top right ($H = 0.3$, orange): rough but with visible short-range structure. Bottom left ($H = 0.5$, blue): standard Brownian motion, the familiar random walk. Bottom right ($H = 0.7$, green): smooth, trending trajectory. Empirically, $\log \RV $ behaves like the top-left panel}{figure.7.1}{}}
\newlabel{fig:hurst-paths@cref}{{[figure][1][7]7.1}{[1][97][]97}{}{}{}}
