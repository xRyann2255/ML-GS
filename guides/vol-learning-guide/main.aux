\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Two price paths over the same trading day. \textbf  {Left:} pure diffusion with no jumps. The path is continuous and smooth. \textbf  {Right:} diffusion plus a single jump at 2:00pm (red dashed line). The open circle marks the pre-jump price; the filled circle marks the post-jump price. Both paths have similar diffusion volatility, but the right path has much higher quadratic variation due to the jump.}}{52}{figure.4.1}\protected@file@percent }
\newlabel{fig:jump-vs-diffusion}{{4.1}{52}{Two price paths over the same trading day. \textbf {Left:} pure diffusion with no jumps. The path is continuous and smooth. \textbf {Right:} diffusion plus a single jump at 2:00pm (red dashed line). The open circle marks the pre-jump price; the filled circle marks the post-jump price. Both paths have similar diffusion volatility, but the right path has much higher quadratic variation due to the jump}{figure.4.1}{}}
\newlabel{fig:jump-vs-diffusion@cref}{{[figure][1][4]4.1}{[1][52][]52}{}{}{}}
