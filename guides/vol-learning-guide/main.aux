\@writefile{toc}{\contentsline {subsection}{\numberline {6.7.5}Ridge vs.\ Lasso on Correlated HAR Features}{88}{subsection.6.7.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6.1}{\ignorespaces Ridge ($L_2$) versus Lasso ($L_1$) on a HAR regression. The correlated-features row is the decisive one: the daily, weekly, and monthly $\operatorname  {RV}$ terms are strongly collinear by construction, so the Lasso's tendency to keep one and drop the rest is a liability, while ridge's group shrinkage preserves all three time scales.}}{89}{table.6.1}\protected@file@percent }
\newlabel{tab:ridge-vs-lasso}{{6.1}{89}{Ridge ($L_2$) versus Lasso ($L_1$) on a HAR regression. The correlated-features row is the decisive one: the daily, weekly, and monthly $\RV $ terms are strongly collinear by construction, so the Lasso's tendency to keep one and drop the rest is a liability, while ridge's group shrinkage preserves all three time scales}{table.6.1}{}}
\newlabel{tab:ridge-vs-lasso@cref}{{[table][1][6]6.1}{[1][88][]89}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.7.6}Why $L_1$ Produces Sparsity but $L_2$ Does Not}{89}{subsection.6.7.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.6}{\ignorespaces Why $L_1$ produces sparsity and $L_2$ does not. The tilted orange ellipses are contours of the HAR sum-of-squares loss; the tilt reflects the strong correlation between $\operatorname  {RV}_d$ and $\operatorname  {RV}_w$. The regularized estimate is where the loss contour first meets the constraint region. \textbf  {Left (ridge):} the $L_2$ ball is round, so the tangency point is generically off-axis, leaving both $\beta _d$ and $\beta _w$ nonzero, shrunk together. \textbf  {Right (Lasso):} the $L_1$ diamond has sharp corners on the axes, and an elongated ellipse almost always touches a corner first, setting $\beta _d = 0$. For collinear HAR components, that corner means dropping a whole time scale.}}{89}{figure.6.6}\protected@file@percent }
\newlabel{fig:l1-l2-geometry}{{6.6}{89}{Why $L_1$ produces sparsity and $L_2$ does not. The tilted orange ellipses are contours of the HAR sum-of-squares loss; the tilt reflects the strong correlation between $\RV _d$ and $\RV _w$. The regularized estimate is where the loss contour first meets the constraint region. \textbf {Left (ridge):} the $L_2$ ball is round, so the tangency point is generically off-axis, leaving both $\beta _d$ and $\beta _w$ nonzero, shrunk together. \textbf {Right (Lasso):} the $L_1$ diamond has sharp corners on the axes, and an elongated ellipse almost always touches a corner first, setting $\beta _d = 0$. For collinear HAR components, that corner means dropping a whole time scale}{figure.6.6}{}}
\newlabel{fig:l1-l2-geometry@cref}{{[figure][6][6]6.6}{[1][89][]89}{}{}{}}
\citation{ZouHastie2005}
\citation{ZouHastie2005}
