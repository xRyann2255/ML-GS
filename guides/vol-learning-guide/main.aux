\@writefile{lof}{\contentsline {figure}{\numberline {21.7}{\ignorespaces The evaluation metric, schematically. Buy-and-hold GSVIVS01 (grey) drips upward and then surrenders the gains on each drawdown day; the forecast overlay (green) stays invested through the calm runs but goes flat on the days the model predicts $\operatorname  {RV}>K_{\mathrm  {var}}$, compounding a higher, smoother path. The metric is the difference between the two: deflated Sharpe, maximum-drawdown reduction, and Calmar. Shape is illustrative; the magnitude is what \Cref  {sec:gsvivs:experiments} must establish on real data.}}{391}{figure.21.7}\protected@file@percent }
\newlabel{fig:gsvivs:overlay}{{21.7}{391}{The evaluation metric, schematically. Buy-and-hold GSVIVS01 (grey) drips upward and then surrenders the gains on each drawdown day; the forecast overlay (green) stays invested through the calm runs but goes flat on the days the model predicts $\RV >\Kvar $, compounding a higher, smoother path. The metric is the difference between the two: deflated Sharpe, maximum-drawdown reduction, and Calmar. Shape is illustrative; the magnitude is what \Cref {sec:gsvivs:experiments} must establish on real data}{figure.21.7}{}}
\newlabel{fig:gsvivs:overlay@cref}{{[figure][7][21]21.7}{[1][391][]391}{}{}{}}
