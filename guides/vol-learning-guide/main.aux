\@writefile{lof}{\contentsline {figure}{\numberline {21.5}{\ignorespaces The down-jump asymmetry of a short variance position (the $1/T$ scaling dropped for clarity). The symmetric $J^2$ parabola (grey dashed) is what a direction-blind view of variance predicts; the actual loss $J^2 + \tfrac  23 J^3$ (red) lies \emph  {above} it for downward jumps and below for upward ones. A $15\%$ down-gap costs the short more than a $15\%$ up-move, which is why GSVIVS01's worst days are crashes \citep  [Table~5, p.~32]{Demeterfi1999}.}}{387}{figure.21.5}\protected@file@percent }
\newlabel{fig:gsvivs:cubic}{{21.5}{387}{The down-jump asymmetry of a short variance position (the $1/T$ scaling dropped for clarity). The symmetric $J^2$ parabola (grey dashed) is what a direction-blind view of variance predicts; the actual loss $J^2 + \tfrac 23 J^3$ (red) lies \emph {above} it for downward jumps and below for upward ones. A $15\%$ down-gap costs the short more than a $15\%$ up-move, which is why GSVIVS01's worst days are crashes \citep [Table~5, p.~32]{Demeterfi1999}}{figure.21.5}{}}
\newlabel{fig:gsvivs:cubic@cref}{{[figure][5][21]21.5}{[1][387][]387}{}{}{}}
