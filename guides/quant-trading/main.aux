\@writefile{lof}{\contentsline {figure}{\numberline {18.1}{\ignorespaces Two common vol-surface shapes in practice. \textbf  {Equity skew} (left): implied vol falls as strike rises. OTM puts are expensive because investors pay a premium for crash protection, so the left wing of the smile is elevated. \textbf  {FX smile} (right): implied vol is roughly symmetric and U-shaped, reflecting comparable demand for OTM calls and puts. Both shapes contradict Black--Scholes's assumption of a flat, constant vol.}}{210}{figure.18.1}\protected@file@percent }
\newlabel{fig:vol_skew_smile}{{18.1}{210}{Two common vol-surface shapes in practice. \textbf {Equity skew} (left): implied vol falls as strike rises. OTM puts are expensive because investors pay a premium for crash protection, so the left wing of the smile is elevated. \textbf {FX smile} (right): implied vol is roughly symmetric and U-shaped, reflecting comparable demand for OTM calls and puts. Both shapes contradict Black--Scholes's assumption of a flat, constant vol}{figure.18.1}{}}
\newlabel{fig:vol_skew_smile@cref}{{[figure][1][18]18.1}{[1][210][]210}{}{}{}}
