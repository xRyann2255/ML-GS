\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Volatility signature plot with three regimes. \textbf  {Left (red):} noise dominates; RV inflated by $2n\omega ^2$. \textbf  {Center (green):} sweet spot where RV is close to true $\operatorname  {IV}_t$. \textbf  {Right (orange):} too few observations; high estimation variance. The dashed blue line is the true integrated variance. The curve flattens around 1--15 minutes for liquid U.S.\ equities.}}{40}{figure.3.2}\protected@file@percent }
\newlabel{fig:vol-sig-detail}{{3.2}{40}{Volatility signature plot with three regimes. \textbf {Left (red):} noise dominates; RV inflated by $2n\omega ^2$. \textbf {Center (green):} sweet spot where RV is close to true $\IVol _t$. \textbf {Right (orange):} too few observations; high estimation variance. The dashed blue line is the true integrated variance. The curve flattens around 1--15 minutes for liquid U.S.\ equities}{figure.3.2}{}}
