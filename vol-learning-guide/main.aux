\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces The conceptual chain connecting the three key quantities. \textbf  {RV} (what you compute from data) converges to \textbf  {QV} (a mathematical limit) as sampling gets finer. Without jumps, QV equals \textbf  {IV} (the true volatility you want). With jumps, QV includes both IV and a jump component (Chapter~\ref {ch:jumps} separates them). Microstructure noise disrupts the convergence at high sampling frequencies (Chapter~\ref {ch:noise} fixes this).}}{28}{figure.2.1}\protected@file@percent }
\newlabel{fig:iv-qv-rv-chain}{{2.1}{28}{The conceptual chain connecting the three key quantities. \textbf {RV} (what you compute from data) converges to \textbf {QV} (a mathematical limit) as sampling gets finer. Without jumps, QV equals \textbf {IV} (the true volatility you want). With jumps, QV includes both IV and a jump component (Chapter~\ref {ch:jumps} separates them). Microstructure noise disrupts the convergence at high sampling frequencies (Chapter~\ref {ch:noise} fixes this)}{figure.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2.2}{\ignorespaces Convergence of RV to integrated variance. Each red dot is an RV estimate from a different simulated day. With only 6 intervals (hourly sampling), estimates are scattered widely around the true $\operatorname  {IV}_t$ (dashed blue). With 78 intervals (5-minute sampling), estimates cluster tightly. This is the convergence result of Equation~\eqref  {eq:rv-convergence} in action. (In practice, microstructure noise prevents going much beyond 78 intervals.)}}{28}{figure.2.2}\protected@file@percent }
\newlabel{fig:rv-convergence-diagram}{{2.2}{28}{Convergence of RV to integrated variance. Each red dot is an RV estimate from a different simulated day. With only 6 intervals (hourly sampling), estimates are scattered widely around the true $\IVol _t$ (dashed blue). With 78 intervals (5-minute sampling), estimates cluster tightly. This is the convergence result of Equation~\eqref {eq:rv-convergence} in action. (In practice, microstructure noise prevents going much beyond 78 intervals.)}{figure.2.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2.3}Diagram: Building RV from a Price Path}{29}{subsection.2.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2.3}{\ignorespaces Constructing realized variance from a price path. Gray: the continuous intraday price. Blue dots: prices sampled at half-hourly intervals ($n = 13$ intervals). Each interval produces a log return $r_{t,i}$. RV is the sum of all squared returns. Sampling more frequently (e.g., every 5 minutes instead of 30) produces more terms in the sum and a more precise estimate.}}{29}{figure.2.3}\protected@file@percent }
\newlabel{fig:rv-construction}{{2.3}{29}{Constructing realized variance from a price path. Gray: the continuous intraday price. Blue dots: prices sampled at half-hourly intervals ($n = 13$ intervals). Each interval produces a log return $r_{t,i}$. RV is the sum of all squared returns. Sampling more frequently (e.g., every 5 minutes instead of 30) produces more terms in the sum and a more precise estimate}{figure.2.3}{}}
\citation{BNS2002}
\citation{BNS2002}
