\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Sample paths of fractional Brownian motion at four values of the Hurst exponent $H$. Top left ($H = 0.1$, red): extremely rough, rapidly oscillating. Top right ($H = 0.3$, orange): rough but with visible short-range structure. Bottom left ($H = 0.5$, blue): standard Brownian motion, the familiar random walk. Bottom right ($H = 0.7$, green): smooth, trending trajectory. Empirically, $\log \operatorname  {RV}$ behaves like the top-left panel.}}{98}{figure.7.1}\protected@file@percent }
\newlabel{fig:hurst-paths}{{7.1}{98}{Sample paths of fractional Brownian motion at four values of the Hurst exponent $H$. Top left ($H = 0.1$, red): extremely rough, rapidly oscillating. Top right ($H = 0.3$, orange): rough but with visible short-range structure. Bottom left ($H = 0.5$, blue): standard Brownian motion, the familiar random walk. Bottom right ($H = 0.7$, green): smooth, trending trajectory. Empirically, $\log \RV $ behaves like the top-left panel}{figure.7.1}{}}
\citation{GJR2018}
\citation{GJR2018}
\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces The Hurst exponent number line. Empirical log-volatility sits at $H \approx 0.1$, deep in the rough regime. Standard stochastic volatility models (Heston, SABR) assume $H = 0.5$. The gap between 0.1 and 0.5 is the motivation for the entire rough volatility program.}}{99}{figure.7.2}\protected@file@percent }
