\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.1}Diagram: Continuous vs.\ Jump Price Paths}{54}{subsection.4.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Two price paths over the same trading day. \textbf  {Left:} pure diffusion with no jumps. The path is continuous and smooth. \textbf  {Right:} diffusion plus a single jump at 2:00pm (red dashed line). The open circle marks the pre-jump price; the filled circle marks the post-jump price. Both paths have similar diffusion volatility, but the right path has much higher quadratic variation due to the jump.}}{54}{figure.4.1}\protected@file@percent }
\newlabel{fig:jump-vs-diffusion}{{4.1}{54}{Two price paths over the same trading day. \textbf {Left:} pure diffusion with no jumps. The path is continuous and smooth. \textbf {Right:} diffusion plus a single jump at 2:00pm (red dashed line). The open circle marks the pre-jump price; the filled circle marks the post-jump price. Both paths have similar diffusion volatility, but the right path has much higher quadratic variation due to the jump}{figure.4.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Bipower Variation}{55}{section.4.2}\protected@file@percent }
\newlabel{sec:bpv}{{4.2}{55}{Bipower Variation}{section.4.2}{}}
\newlabel{eq:bpv}{{4.1}{55}{Bipower Variation}{equation.4.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.1}Why the $\pi /2$ Scaling Factor}{55}{subsection.4.2.1}\protected@file@percent }
\citation{BNS2004}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.2}Diagram: How RV and BPV Respond to a Jump}{56}{subsection.4.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces How a jump affects $\operatorname  {RV}$ vs.\ $\operatorname  {BPV}$. \textbf  {Left:} the jump return $r_4$ contributes $3.24 \times 10^{-4}$ to $\operatorname  {RV}$ (via $r_4^2$), completely dominating all other terms. \textbf  {Right:} in $\operatorname  {BPV}$, the jump is multiplied by its normal-sized neighbors. The two terms involving $r_4$ contribute only $0.17$ and $0.11 \times 10^{-4}$, roughly 50$\times $ smaller than the squared jump. $\operatorname  {BPV}$ ``sees through'' the jump and recovers the continuous variation.}}{56}{figure.4.2}\protected@file@percent }
\newlabel{fig:rv-vs-bpv}{{4.2}{56}{How a jump affects $\RV $ vs.\ $\BPV $. \textbf {Left:} the jump return $r_4$ contributes $3.24 \times 10^{-4}$ to $\RV $ (via $r_4^2$), completely dominating all other terms. \textbf {Right:} in $\BPV $, the jump is multiplied by its normal-sized neighbors. The two terms involving $r_4$ contribute only $0.17$ and $0.11 \times 10^{-4}$, roughly 50$\times $ smaller than the squared jump. $\BPV $ ``sees through'' the jump and recovers the continuous variation}{figure.4.2}{}}
