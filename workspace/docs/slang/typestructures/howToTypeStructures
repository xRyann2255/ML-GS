Exercises
Exercise 1
Write a function that accepts a typed structure as input, evaluates a method called Get Area on that typed structure, and returns the square root of that number. The input typed structure must be guaranteed to have a Get Area method. You may create whatever Typed Structure definitions and/or interfaces are necessary to provide that guarantee.


 TypeDefineInterface( "ABC::Get Area" ) {
   Get Area = Func( Self ) Returns( Double() ) { };
 };

 TypeDefine( "ABC::Test" ) {
   Get Area = Func( Self ) Returns( Double() ) { Return( 25 ); };
   Members()
   Implements( "ABC::Get Area" );
 };

 Private::Exercise 1 = Func( ABC::Get Area( Input ) ) Returns( Double() ) {
   Return( Sqrt( Input.Get Area() ) );
 };

 Printf( "Square Root of Get Area() is %d\n", @Private::Exercise 1( ABC::Test() ) );
Exercise 2
Create a base class which may not be inherited by a derived class. Demonstrate that you get an exception when you attempt to inherit the from this base class.


 TypeDefine( "ABC::Test" ) {
   _Flags = TypedStructureFlag::Support Properties | TypedStructureFlag::Check Arguments | TypedStructureFlag::Sealed;

   Get Area = Func( Self ) Returns( Double() ) { Return( 25 ); };
   Members()
 };

 AssertException( "Cannot inherited a Sealed Class", TypeDefine( "ABC::Test Inherit" ){ Members( "ABC::Test" ) } );
Exercise 3
Create a Typed Structure definition that includes a data member called Foo. Create a second data member that contains a count of the number of times Foo is accessed on a given instance, where the count is automatically updated whenever Foo is accessed.


 TypeUnDefine( "ABC::Test" );
 TypeDefine( "ABC::Test" ) {
   _Flags = TypedStructureFlag::Support Properties | TypedStructureFlag::Check Arguments;

   Foo Getter = Func( Self ) Returns( String() ) {
       Self.p_Count Of Foo++;
       Return( Self.p_Foo );
   };

   Foo Setter = Func( Self, String( New Value ) ) Returns( ) {
       Self.p_Foo = New Value;
       Self.p_Count Of Foo++;
   };

   Count Getter = Func( Self ) Returns( Double() ) {
       Return( Self.p_Count Of Foo );
   };

   Members( )
   {
       String( p_Foo )           := "Foo";
       Double( p_Count Of Foo )  := 0;
   };
 };

 X = Apply( "ABC::Test" );
 Printf( "Count is %d\n", X.Count );
 Printf( "Read value of Foo: %s\n", X.Foo );
 Printf( "Count is %d\n", X.Count );
 Printf( "Write value of Foo: %s\n", ( X.Foo = "Foo New" ) );    //N.B: Writing here does an implicit read
 Printf( "Count is %d\n", X.Count );