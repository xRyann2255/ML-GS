  "files": {
    "src/mini/core.py": {
      "1": "\"\"\"Core registry for the mini pipeline.\"\"\"",
      "2": "",
      "3": "REGISTRY = {}",
      "4": "",
      "5": "def register(name):",
      "6": "    \"\"\"Bind a component class to a config name.\"\"\"",
      "7": "    def deco(cls):",
      "8": "        REGISTRY[name] = cls",
      "9": "        return cls",
      "10": "    return deco"
    },
    "src/mini/measures.py": {
      "12": "def realized_variance(returns):",
      "13": "    \"\"\"Sum of squared intraday returns for one day.\"\"\"",
      "14": "    return sum(r * r for r in returns)",
      "15": "",
      "16": "def daily_panel(ticks):",
      "17": "    return [realized_variance(day) for day in ticks]"
    }
  },
