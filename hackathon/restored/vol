#!/usr/bin/env bash
# vol — Project CLI wrapper for volforecast.
# Handles environment setup (uv, venv, LD_LIBRARY_PATH) internally.
# Run from any directory. Usage: ./vol help

set -euo pipefail

# ---- Resolve project root from script location (follows symlinks) ----
_SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$_SCRIPT" ]]; do
    _DIR="$(cd "$(dirname "$_SCRIPT")" && pwd)"
    _SCRIPT="$(readlink "$_SCRIPT")"
    [[ "$_SCRIPT" != /* ]] && _SCRIPT="${_DIR}/${_SCRIPT}"
done
ROOT="$(cd "$(dirname "$_SCRIPT")" && pwd)"
unset _SCRIPT _DIR
SRC="${ROOT}/src"

# ---- OS guard: ./vol is S-B (GS Linux Coder workspace) only ----
case "$(uname -s)" in
    Linux) ;;
    *)
        echo "ERROR: ./vol requires the GS Linux Coder workspace (nix+uv). On Windows use vol.cmd (dev loop) or VS Code tasks." >&2
        exit 2
        ;;
esac

# ---- Verify uv is available ----
if ! command -v uv &>/dev/null; then
    echo "ERROR: uv not found on PATH. Install via: nix-env -iA nixpkgs.uv (Coder workspace) or pipx install uv" >&2
    exit 1
fi

# ---- Change to src/ where pyproject.toml lives ----
if [[ ! -d "$SRC" ]]; then
    echo "ERROR: src/ directory not found at ${SRC}" >&2
    exit 1
fi
cd "$SRC"

# ---- Set _NIX_PY_LD_PATH for nix Python C-extension support ----
# Pip/uv-installed wheels (numpy, scipy) link against libstdc++ and libz
# which are in the nix store but not on the default library search path.
# We compute the path but only apply it to Python processes (not ruff, etc.)
# because manylinux binaries break when nix's libgcc_s.so is on LD_LIBRARY_PATH.
_NIX_PY_LD_PATH=""
_PY_STORE="$(readlink -f "$(command -v python3)" | sed 's|/bin/python3.*||')"
if [[ "$_PY_STORE" == /nix/store/* ]]; then
    while IFS= read -r dep; do
        if [[ -d "${dep}/lib" ]]; then
            _NIX_PY_LD_PATH="${_NIX_PY_LD_PATH:+${_NIX_PY_LD_PATH}:}${dep}/lib"
        fi
    done < <(nix-store --query --references "$_PY_STORE" 2>/dev/null | grep -E "gcc.*lib|zlib")
fi
unset _PY_STORE

# ---- Bootstrap venv if needed ----
if [[ ! -f "${SRC}/.venv/bin/python" ]]; then
    echo "First run: creating venv..."
    uv sync --frozen --extra ml
fi

# ---- Ensure system-site-packages is enabled (exposes pytickclient, pyslang) ----
if grep -q "include-system-site-packages = false" "${SRC}/.venv/pyvenv.cfg" 2>/dev/null; then
    sed -i 's/include-system-site-packages = false/include-system-site-packages = true/' "${SRC}/.venv/pyvenv.cfg"
fi

# ---- Activate venv ----
source "${SRC}/.venv/bin/activate"

# ---- Ensure TMP and LOCATION are set (needed by pytickclient) ----
export TMP="${TMP:-/tmp}"
export LOCATION="${LOCATION:-NYC}"

# ---- Skip pyslang train env sourcing (no /sw/ficc on Coder workspaces) ----
export ARON_MAPALIAS_INITIALIZED="${ARON_MAPALIAS_INITIALIZED:-1}"

# ---- Ensure gs-quant >= 1.6.0 (system-provided, not in lockfile) ----
_GQ_VER=$(python -c "import gs_quant; print(gs_quant.__version__)" 2>/dev/null || echo "0.0.0")
if [[ "$(printf '%s\n' "1.6.0" "$_GQ_VER" | sort -V | head -1)" != "1.6.0" ]]; then
    echo "Upgrading gs-quant (${_GQ_VER} < 1.6.0)..."
    uv pip install "gs-quant>=1.6.0" --quiet 2>/dev/null || true
fi
unset _GQ_VER

# ---- Dispatch subcommand ----
CMD="${1:-help}"
shift || true

case "$CMD" in
    help)
        cat <<'EOF'
