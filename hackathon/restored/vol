    exec)
        # Execute any command with output captured to a unique temp file.
        # Uses setsid to create a new process group — immune to terminal SIGINT/SIGHUP.
        # Usage: vol exec <command> [args...]
        # Prints: OUTPUT_FILE=<path> then runs, writing stdout+stderr to that file.
        if [[ $# -eq 0 ]]; then
            echo "ERROR: vol exec requires a command. Usage: vol exec <command> [args...]" >&2
            exit 1
        fi
        _OUT_DIR="${ROOT}/workspace/tmp/exec"
        mkdir -p "$_OUT_DIR"
        _OUT_FILE="${_OUT_DIR}/$(date +%s)_$$.out"
        echo "OUTPUT_FILE=${_OUT_FILE}"
        # Run in a new session (setsid) so terminal SIGINT doesn't propagate.
        # The process survives terminal death/recycling.
        setsid bash -c '
            cd "'"$SRC"'" && source .venv/bin/activate
            export TMP="${TMP:-/tmp}" LOCATION="${LOCATION:-NYC}"
            export LD_LIBRARY_PATH="'"${_NIX_PY_LD_PATH}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"'"
            '"$(printf '%q ' "$@")"' > "'"$_OUT_FILE"'" 2>&1
            echo "EXIT_CODE=$?" >> "'"$_OUT_FILE"'"
        ' &
        _PID=$!
        echo "PID=${_PID}"
        echo "${_PID}" > "${_OUT_FILE}.pid"
        # Wait for the detached process to finish (blocks caller, but immune to SIGINT)
        wait $_PID 2>/dev/null
        _EXIT=$?
        rm -f "${_OUT_FILE}.pid"
        echo "---"
        echo "Done. Read: ${_OUT_FILE}"
        exit $_EXIT
        ;;
    bg)
        # Fire-and-forget execution. Process is fully detached (new session + disown).
        # Returns immediately with OUTPUT_FILE and PID. Agent polls the output file
        # for an "EXIT_CODE=" line to know when the command has completed.
        # Usage: vol bg <command> [args...]
        if [[ $# -eq 0 ]]; then
            echo "ERROR: vol bg requires a command. Usage: vol bg <command> [args...]" >&2
            exit 1
        fi
        _OUT_DIR="${ROOT}/workspace/tmp/exec"
        mkdir -p "$_OUT_DIR"
        _SLUG="${VOL_SLUG:-bg}"
        _OUT_FILE="${_OUT_DIR}/${_SLUG}_$(date +%s)_$$.out"
        echo "OUTPUT_FILE=${_OUT_FILE}"
        # Launch fully detached — new session, stdout/stderr closed, disowned.
        setsid bash -c '
            cd "'"$SRC"'" && source .venv/bin/activate
            export TMP="${TMP:-/tmp}" LOCATION="${LOCATION:-NYC}"
            export LD_LIBRARY_PATH="'"${_NIX_PY_LD_PATH}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"'"
            '"$(printf '%q ' "$@")"' > "'"$_OUT_FILE"'" 2>&1
            echo "EXIT_CODE=$?" >> "'"$_OUT_FILE"'"
        ' &>/dev/null &
        disown
        _PID=$!
        echo "PID=${_PID}"
        echo "${_PID}" > "${_OUT_FILE}.pid"
        echo "---"
        echo "Launched. Poll OUTPUT_FILE for EXIT_CODE= sentinel."
        ;;
    jobs)
        # List running and completed background jobs from vol bg / vol exec.
        # Reads .pid files in workspace/tmp/exec/ and checks process status.
        _OUT_DIR="${ROOT}/workspace/tmp/exec"
        _found=0
        if [[ -d "$_OUT_DIR" ]]; then
            for _pf in "${_OUT_DIR}/"*.pid; do
                [[ -f "$_pf" ]] || continue
                _found=1
                _pid=$(cat "$_pf")
                _out="${_pf%.pid}"
                if kill -0 "$_pid" 2>/dev/null; then
                    echo "RUNNING  pid=${_pid}  output=${_out}"
                else
                    echo "DONE     pid=${_pid}  output=${_out}"
                    rm -f "$_pf"  # clean up dead PID file
                fi
            done
        fi
        if [[ $_found -eq 0 ]]; then
            echo "No background jobs found."
        fi
        ;;
    *)
        echo "ERROR: Unknown command \"${CMD}\". Run \"vol help\" for usage." >&2
        exit 1
        ;;
esac
