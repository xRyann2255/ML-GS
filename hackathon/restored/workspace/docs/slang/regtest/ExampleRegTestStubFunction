/****************************************************************
**  Routine: Private::Test Container ReadAll
**
**  Test for overwriting Container::ReadAll() by intercepting
**  this function call and deciding whether to pass it to original
**  function or capture it and return different results.
****************************************************************/
Private::Test Container ReadAll = Func()
Returns()
{
    Container ReadAll Orig = Container::ReadAll;

    DCP Cont = Structure( "Some", "DCP Content" );

    /****************************************************************
    **  Routine: Container ReadAll Mock Func
    **
    **  Mock function for Container ReadAll.
    ****************************************************************/
    Container ReadAll Mock Func = Lambda(
        String( Container ),
        Double( Refresh )               := False,
        Database( Database )            := Database(),
        Double( Dont Cache )            := False,
        Double( Lock In Cache )         := False,
        Structure( Default )            := Null::Structure,
        Double( Min Refresh Interval )  := Null::Double,
    )
    {
        // If the container name does not start with "DCP " call the original Container::ReadAll function
        If( !StrBegins( Container, "DCP " ) )
        {
            Printf( ">>> Reading '%s' from '%s'.\n", Container, Database );
            Cont = @Container ReadAll Orig(
                Container,
                Refresh := Refresh,
                Database := Database,
                Dont Cache := Dont Cache,
                Lock In Cache := Lock In Cache,
                Default := Default,
                Min Refresh Interval := Min Refresh Interval,
            );
        }
        :
        {
            // If container names starts with "DCP " return DCP Cont variable instead
            Printf( ">>> Using DCP Cont for '%s' container contents.\n", Container );
            Cont = DCP Cont;
        };
        Return( Cont );
    };

    RegTestStubFunction( Structure(
        "_LIB Container Functions::Container::ReadAll", Container ReadAll Mock Func,
    ) )
    {
        // Test reading from an arbitrary container from the current database
        ForSecurity( Sec, "Container", "A", "Z~" )
        {
            // Read a container that is passed through
            Cont = @Container::ReadAll( Sec );
            Assert( Null != Cont );
            Break;
        };

        // Test reading container prefixed with special string "DCP "
        Cont = @Container::ReadAll( "DCP Test Container" );
        Assert( Cont == DCP Cont );
    };
    Return();
};

